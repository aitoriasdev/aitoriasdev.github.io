---
import { Image } from 'astro:assets';
import profileImage from '../assets/images/aitorias.png';
import Icon from './ui/Icon.astro';

interface TechTag {
  name: string;
}

const STACK: TechTag[] = [
  { name: 'TypeScript' },
  { name: 'React' },
  { name: 'Tailwind CSS' },
  { name: 'Astro' },
];
---

<section class="relative py-10 lg:py-20" id="about">
  <div class="mx-auto flex max-w-5xl flex-col-reverse items-start justify-between gap-12 px-6 md:flex-row md:items-center">
    <div class="flex-1 space-y-6">
      <!-- Status Badge -->
      <div class="inline-flex items-center gap-2 rounded-full border border-accent-primary/30 bg-accent-primary/10 px-3 py-1 text-xs font-semibold text-text-main-light dark:text-text-main-dark">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent-primary opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-accent-primary"></span>
        </span>
        Available for new opportunities
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-text-main-light sm:text-5xl lg:text-6xl dark:text-text-main-dark">
        Front-End Developer crafting web experiences.
      </h1>

      <p class="text-lg leading-relaxed text-text-muted-light dark:text-text-muted-dark">
        Hi, I'm <strong class="font-semibold text-text-main-light dark:text-text-main-dark">Aitor</strong>. I specialize in building accessible, high-performance web applications with clean, modern code architectures.
      </p>
      <!-- Tech Stack Badges -->
      <div class="flex flex-wrap items-center gap-2 pt-2">
        <span class="text-xs font-semibold uppercase tracking-wider text-text-muted-light dark:text-text-muted-dark">
          Core Stack:
        </span>
        {STACK.map((tech) => (
          <span class="rounded-md bg-surface-light px-2.5 py-1 text-xs font-medium text-text-main-light ring-1 ring-inset ring-border-light dark:bg-surface-dark dark:text-text-main-dark dark:ring-border-dark">
            {tech.name}
          </span>
        ))}
      </div>
      <!-- Action Buttons -->
      <div class="flex flex-wrap gap-4 pt-4">
        <!-- Primary CTA: Matcha Accent -->
        <a
          href="#projects"
          class="inline-flex items-center justify-center rounded-lg bg-accent-primary px-5 py-3 text-sm font-semibold text-bg-light transition hover:opacity-90 dark:text-bg-dark"
        >
          View Projects
        </a>
        <!-- Secondary CTA: GitHub Button with Dual Icons -->
        <a
          href="https://github.com/aitoriasdev"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-lg border border-border-light bg-surface-light px-5 py-3 text-sm font-semibold text-text-main-light transition hover:border-accent-primary hover:text-accent-primary dark:border-border-dark dark:bg-surface-dark dark:text-text-main-dark dark:hover:border-accent-primary dark:hover:text-accent-primary"
        >
          <!-- GitHub Icon -->
          <Icon name="github" class="h-5 w-5" />
          <span>GitHub Profile</span>
          <!-- External Link Icon -->
           <Icon name="external" class="h-4 w-4" />
        </a>
      </div>
    </div>
    <!-- Hero Image with Pastel Gradient Aura -->
    <div class="relative shrink-0">
      <div class="absolute -inset-1 rounded-full bg-linear-to-r from-accent-primary to-accent-secondary opacity-40 blur-lg dark:opacity-30"></div>
      <Image
        src={profileImage}
        alt="Aitor - Front End Developer"
        width={192}
        height={192}
        loading="eager"
        class="relative h-36 w-36 rounded-full border-2 border-border-light object-cover shadow-xl dark:border-border-dark sm:h-48 sm:w-48"
      />
    </div>
  </div>
</section>
