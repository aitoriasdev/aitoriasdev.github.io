---
import { Image } from 'astro:assets';
import Badge from './ui/Badge.astro';
import Icon from './ui/Icon.astro';
import Link from './ui/Link.astro';
import profileImage from '../assets/images/aitorias.png';

interface TechTag {
  name: string;
}

const STACK: TechTag[] = [
  { name: 'TypeScript' },
  { name: 'React' },
  { name: 'Tailwind CSS' },
  { name: 'Astro' },
];
---

<section class="relative py-10 lg:py-20" id="about">
  <div class="mx-auto flex max-w-5xl flex-col-reverse items-start justify-between gap-12 px-6 md:flex-row md:items-center">
    <div class="flex-1 space-y-6">
      <!-- Status Badge Atom -->
      <Badge variant="status">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent-primary opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-accent-primary"></span>
        </span>
        Available for new opportunities
      </Badge>
      <h1 class="text-4xl font-bold tracking-tight text-text-main-light sm:text-5xl lg:text-6xl dark:text-text-main-dark">
        Front-End Developer crafting web experiences.
      </h1>
      <p class="text-lg leading-relaxed text-text-muted-light dark:text-text-muted-dark">
        Hi, I'm <strong class="font-semibold text-text-main-light dark:text-text-main-dark">Aitor</strong>. I specialize in building accessible, high-performance web applications with clean, modern code architectures.
      </p>
      <!-- Tech Stack Badges -->
      <div class="flex flex-wrap items-center gap-2 pt-2">
        <span class="text-md font-semibold uppercase tracking-wider text-text-muted-light dark:text-text-muted-dark">
          Core Stack:
        </span>
        {STACK.map((tech) => (
          <Badge variant="surface">{tech.name}</Badge>
        ))}
      </div>
      <!-- Action Link Atoms -->
      <div class="flex flex-wrap gap-4 pt-4">
        <Link href="#projects" variant="button-primary">
          View Projects
        </Link>
        <Link href="https://github.com/aitoriasdev" isExternal variant="button-secondary">
          <Icon name="github" class="h-5 w-5" />
          <span>GitHub Profile</span>
          <Icon name="external" class="h-4 w-4" />
        </Link>
      </div>
    </div>
    <!-- Hero Image -->
    <div class="relative shrink-0">
      <div class="absolute -inset-1 rounded-full bg-linear-to-r from-accent-primary to-accent-secondary opacity-40 blur-lg dark:opacity-30"></div>
      <Image
        src={profileImage}
        alt="Aitor - Front End Developer"
        width={192}
        height={192}
        loading="eager"
        class="relative h-36 w-36 rounded-full object-cover shadow-xl sm:h-48 sm:w-48"
      />
    </div>
  </div>
</section>
