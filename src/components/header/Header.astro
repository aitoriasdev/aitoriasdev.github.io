---
import Logo from './Logo.astro';
import NavMenu from './menu/NavMenu.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="sticky top-0 w-full border-b border-border-light bg-bg-light/80 backdrop-blur-md dark:border-border-dark dark:bg-bg-dark/80">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <Logo />
    <NavMenu />
    <ThemeToggle />
  </div>
</header>
