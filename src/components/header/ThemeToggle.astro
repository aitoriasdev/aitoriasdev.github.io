<div class="relative inline-flex items-center rounded-full border border-border-light bg-surface-light p-1 dark:border-border-dark dark:bg-surface-dark">
  <button
    type="button"
    data-theme-value="light"
    aria-label="Light theme"
    class="theme-btn flex h-7 w-7 items-center justify-center rounded-full text-text-muted-light transition-colors hover:text-text-main-light dark:text-text-muted-dark dark:hover:text-text-main-dark"
  >
    <!-- Sun Icon -->
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
    </svg>
  </button>

  <button
    type="button"
    data-theme-value="dark"
    aria-label="Dark theme"
    class="theme-btn flex h-7 w-7 items-center justify-center rounded-full text-text-muted-light transition-colors hover:text-text-main-light dark:text-text-muted-dark dark:hover:text-text-main-dark"
  >
    <!-- Moon Icon -->
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
    </svg>
  </button>

  <button
    type="button"
    data-theme-value="system"
    aria-label="System theme"
    class="theme-btn flex h-7 w-7 items-center justify-center rounded-full text-text-muted-light transition-colors hover:text-text-main-light dark:text-text-muted-dark dark:hover:text-text-main-dark"
  >
    <!-- Monitor/System Icon -->
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
    </svg>
  </button>
</div>

<script>
  type Theme = 'light' | 'dark' | 'system';

  function initThemeToggle() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.theme-btn');
    if (!buttons.length) return;

    const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');

    function getStoredTheme(): Theme {
      return (localStorage.getItem('theme') as Theme) || 'system';
    }

    function applyTheme(theme: Theme) {
      const isDark = theme === 'dark' || (theme === 'system' && mediaQuery.matches);
      document.documentElement.classList.toggle('dark', isDark);

      buttons.forEach((btn) => {
        const val = btn.getAttribute('data-theme-value');
        const isActive = val === theme;

        // Active state with Japanese Pastel tokens
        btn.classList.toggle('bg-bg-light', isActive);
        btn.classList.toggle('dark:bg-bg-dark', isActive);
        btn.classList.toggle('text-accent-primary', isActive);
        btn.classList.toggle('shadow-sm', isActive);

        // Inactive state
        btn.classList.toggle('text-text-muted-light', !isActive);
        btn.classList.toggle('dark:text-text-muted-dark', !isActive);
      });
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-theme-value') as Theme;
        localStorage.setItem('theme', val);
        applyTheme(val);
      });
    });

    mediaQuery.addEventListener('change', () => {
      if (getStoredTheme() === 'system') {
        applyTheme('system');
      }
    });

    applyTheme(getStoredTheme());
  }

  initThemeToggle();
  document.addEventListener('astro:page-load', initThemeToggle);
</script>
