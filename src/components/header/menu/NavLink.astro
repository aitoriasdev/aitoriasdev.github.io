---
import Link from '../../ui/Link.astro';

interface Props {
  href: string;
  label: string;
  variant?: 'desktop' | 'mobile';
}

const { href, label, variant = 'desktop' } = Astro.props;
const pathname = Astro.url.pathname;
const isActive = pathname === href || (href !== '/' && pathname.startsWith(href));
---

{
  variant === 'mobile' ? (
    <a
      href={href}
      aria-current={isActive ? 'page' : undefined}
      class:list={[
        'mobile-nav-link block w-full rounded-xl px-4 py-3 text-sm font-semibold transition-all',
        isActive
          ? 'bg-accent-primary text-bg-light dark:text-bg-dark'
          : 'text-text-muted-light hover:bg-surface-light hover:text-text-main-light dark:text-text-muted-dark dark:hover:bg-surface-dark dark:hover:text-text-main-dark',
      ]}
    >
      {label}
    </a>
  ) : (
    <Link
      href={href}
      aria-current={isActive ? 'page' : undefined}
      class:list={[
        'relative py-1 text-xs font-medium',
        isActive
          ? 'font-semibold text-accent-primary'
          : 'text-text-muted-light hover:text-text-main-light dark:text-text-muted-dark dark:hover:text-text-main-dark',
      ]}
    >
      {label}
    </Link>
  )
}
