<button
  id="mobile-menu-toggle"
  type="button"
  class="relative z-50 flex h-10 w-10 items-center justify-center rounded-lg p-2 text-text-main-light transition-colors hover:bg-surface-light focus:outline-none dark:text-text-main-dark dark:hover:bg-surface-dark md:hidden"
  aria-label="Toggle Navigation Menu"
  aria-expanded="false"
>
  <div class="relative flex h-5 w-5 flex-col justify-between">
    <span id="bar-top" class="h-0.5 w-full rounded-full bg-current transition-all duration-300 origin-center"></span>
    <span id="bar-mid" class="h-0.5 w-full rounded-full bg-current transition-all duration-300"></span>
    <span id="bar-bot" class="h-0.5 w-full rounded-full bg-current transition-all duration-300 origin-center"></span>
  </div>
</button>
