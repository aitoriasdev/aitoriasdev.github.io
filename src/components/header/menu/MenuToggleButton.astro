---
import Button from '../../shared/Button.astro';
---

<Button
  id="mobile-menu-toggle"
  variant="ghost"
  size="sm"
  class="relative z-50 flex items-center gap-2 md:hidden"
  aria-label="Toggle Navigation Menu"
  aria-expanded="false"
>
  <span class="text-sm font-semibold tracking-wide text-text-main-light dark:text-text-main-dark">
    Menu
  </span>
  <div class="relative flex h-4 w-4 flex-col justify-between" aria-hidden="true">
    <span id="bar-top" class="h-0.5 w-full origin-center rounded-full bg-current transition-all duration-300"></span>
    <span id="bar-mid" class="h-0.5 w-full rounded-full bg-current transition-all duration-300"></span>
    <span id="bar-bot" class="h-0.5 w-full origin-center rounded-full bg-current transition-all duration-300"></span>
  </div>
</Button>
