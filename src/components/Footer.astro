---
import Link from './shared/Link.astro';
import Logo from './shared/Logo.astro';
import SocialLinks from './SocialLinks.astro';

const currentYear = new Date().getFullYear();
---

<footer class="bg-surface-light/50 py-10 dark:bg-surface-dark/50">
  <div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-6 px-6 sm:flex-row">
      <!-- Brand & Copyright -->
      <div class="flex flex-col items-center gap-1 sm:items-start">
        <Logo />
        <div class="flex gap-1 text-xs text-text-muted-light dark:text-text-muted-dark">
          <span>&copy; {currentYear} aitorias.dev. Built with</span>
          <Link href="https://astro.build" isExternal class="underline hover:text-accent-primary">
            Astro
          </Link>
          <span>&</span>
          <Link href="https://tailwindcss.com/" isExternal class="underline hover:text-accent-primary">
            Tailwind CSS
          </Link>
        </div>
      </div>
      <!-- Social Links -->
      <SocialLinks />
    </div>
</footer>
