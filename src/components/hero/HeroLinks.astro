---
import Icon from './../shared/Icon.astro';
import Link from './../shared/Link.astro';
---

<div class="flex flex-wrap gap-4 pt-4">
  <Link href="https://github.com/aitoriasdev" isExternal variant="button-primary">
    <Icon name="github" class="h-5 w-5" />
    <span>GitHub Profile</span>
    <Icon name="external" class="h-4 w-4" />
  </Link>
  <Link href="https://linkedin.com/in/aitordediego" isExternal variant="button-primary">
    <Icon name="linkedin" class="h-5 w-5" />
    <span>LinkedIn</span>
    <Icon name="external" class="h-4 w-4" />
  </Link>
</div>
