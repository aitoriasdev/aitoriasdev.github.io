---
import Icon from './Icon.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!-- Floating Cookie Trigger Button -->
<button
  id="cookie-reopen-btn"
  type="button"
  class="fixed bottom-5 left-5 z-30 hidden items-center justify-center gap-2 rounded-full border border-surface-light bg-bg-light p-3 text-text-light shadow-xl backdrop-blur-md transition-all duration-300 motion-reduce:transition-none hover:border-accent-primary hover:text-accent-primary dark:border-surface-dark dark:bg-bg-dark dark:text-text-dark"
  aria-label={t('cookies.manage')}
>
  <Icon name="cookie" class="h-5 w-5" />
  <span class="sr-only">{t('cookies.title')}</span>
</button>

<!-- Main Cookie Banner (Positioned on the Left) -->
<div
  id="cookie-banner"
  class="fixed bottom-4 left-4 right-4 z-40 hidden max-w-md rounded-2xl border border-surface-light bg-bg-light/95 p-5 shadow-2xl backdrop-blur-md dark:border-surface-dark dark:bg-bg-dark/95 md:right-auto"
  role="region"
  aria-label={t('cookies.title')}
>
  <div class="flex items-start justify-between gap-2">
    <div class="flex items-center gap-2">
      <p class="text-md font-semibold text-text-light dark:text-text-dark">
        {t('cookies.title')}
      </p>
      <!-- Live Status Badge -->
      <span
        id="cookie-status-badge"
        class="hidden rounded-full px-2 py-0.5 text-md font-semibold uppercase tracking-wider"
        data-label-accepted={t('cookies.statusAccepted')}
        data-label-denied={t('cookies.statusDenied')}
      ></span>
    </div>
    <!-- Banner Close Button -->
    <button
      id="btn-close-banner"
      type="button"
      class="rounded-lg p-1 text-text-muted-light transition-colors motion-reduce:transition-none hover:bg-surface-light hover:text-text-light dark:text-text-muted-dark dark:hover:bg-surface-dark dark:hover:text-text-dark"
      aria-label={t('cookies.close')}
    >
      <Icon name="close" class="h-4 w-4" />
    </button>
  </div>
  <p class="mt-2 text-md text-text-muted-light dark:text-text-muted-dark">
    {t('cookies.description')}
  </p>
  <!-- Cookie Details Section -->
  <details class="group mt-3 border-t border-surface-light pt-3 text-md dark:border-surface-dark">
    <summary class="cursor-pointer font-medium text-accent-primary hover:underline focus:outline-none">
      {t('cookies.viewDetails')}
    </summary>
    <div class="mt-2 space-y-2 text-text-muted-light dark:text-text-muted-dark">
      <div class="rounded-lg bg-surface-light/50 p-2 dark:bg-surface-dark/50">
        <div class="flex items-center justify-between font-semibold text-text-light dark:text-text-dark">
          <span>{t('cookies.essentialTitle')}</span>
          <span class="text-md text-accent-primary">{t('cookies.required')}</span>
        </div>
        <p class="mt-1 text-md">
          <strong class="font-medium">analytics-consent:</strong> {t('cookies.essentialDesc')}
        </p>
      </div>
      <div class="rounded-lg bg-surface-light/50 p-2 dark:bg-surface-dark/50">
        <div class="flex items-center justify-between font-semibold text-text-light dark:text-text-dark">
          <span>{t('cookies.analyticsTitle')}</span>
          <span class="text-md text-text-muted-light dark:text-text-muted-dark">{t('cookies.analyticsVendor')}</span>
        </div>
        <p class="mt-1 text-md">
          <strong class="font-medium">_ga, _ga_*:</strong> {t('cookies.analyticsDesc')}
        </p>
      </div>
    </div>
  </details>
  <div class="mt-4 flex items-center justify-end gap-3">
    <button
      id="btn-deny"
      type="button"
      class="rounded-xl px-4 py-2 text-md font-semibold text-text-muted-light transition-colors motion-reduce:transition-none hover:bg-surface-light dark:text-text-muted-dark dark:hover:bg-surface-dark"
    >
      {t('cookies.deny')}
    </button>
    <button
      id="btn-accept"
      type="button"
      class="rounded-xl bg-accent-primary px-4 py-2 text-md font-semibold text-white transition-opacity motion-reduce:transition-none hover:opacity-90 dark:text-bg-dark"
    >
      {t('cookies.accept')}
    </button>
  </div>
</div>

<script is:inline>
  function initCookieBanner() {
    const banner = document.getElementById('cookie-banner');
    const reopenBtn = document.getElementById('cookie-reopen-btn');
    const closeBtn = document.getElementById('btn-close-banner');
    const statusBadge = document.getElementById('cookie-status-badge');
    const acceptBtn = document.getElementById('btn-accept');
    const denyBtn = document.getElementById('btn-deny');

    function updateUI(consent) {
      if (!statusBadge || !reopenBtn || !banner) return;

      if (consent) {
        statusBadge.className = 'rounded-full px-2 py-0.5 text-md font-semibold uppercase tracking-wider';

        const labelAccepted = statusBadge.getAttribute('data-label-accepted') || 'Accepted';
        const labelDenied = statusBadge.getAttribute('data-label-denied') || 'Denied';

        if (consent === 'granted') {
          statusBadge.textContent = labelAccepted;
          statusBadge.classList.add('bg-emerald-100', 'text-emerald-800', 'dark:bg-emerald-950', 'dark:text-emerald-300');
        } else {
          statusBadge.textContent = labelDenied;
          statusBadge.classList.add('bg-rose-100', 'text-rose-800', 'dark:bg-rose-950', 'dark:text-rose-300');
        }

        banner.classList.add('hidden');
        reopenBtn.classList.remove('hidden');
        reopenBtn.classList.add('flex');
      } else {
        banner.classList.remove('hidden');
        reopenBtn.classList.add('hidden');
        reopenBtn.classList.remove('flex');
        statusBadge.classList.add('hidden');
      }
    }

    function closeBanner() {
      const currentConsent = localStorage.getItem('analytics-consent');

      if (currentConsent) {
        banner?.classList.add('hidden');
        reopenBtn?.classList.remove('hidden');
        reopenBtn?.classList.add('flex');
      } else {
        banner?.classList.add('hidden');
      }
    }

    function setConsent(value) {
      localStorage.setItem('analytics-consent', value);
      updateUI(value);

      if (typeof window.gtag === 'function') {
        window.gtag('consent', 'update', {
          analytics_storage: value,
        });
      }
    }

    acceptBtn?.addEventListener('click', () => setConsent('granted'));
    denyBtn?.addEventListener('click', () => setConsent('denied'));
    closeBtn?.addEventListener('click', closeBanner);

    reopenBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      reopenBtn.classList.add('hidden');
      reopenBtn.classList.remove('flex');
      banner?.classList.remove('hidden');
    });

    // Close on click outside
    document.addEventListener('click', (event) => {
      if (
        banner &&
        !banner.classList.contains('hidden') &&
        !banner.contains(event.target) &&
        !reopenBtn?.contains(event.target)
      ) {
        closeBanner();
      }
    });

    const currentConsent = localStorage.getItem('analytics-consent');

    updateUI(currentConsent);
  }

  initCookieBanner();
  document.addEventListener('astro:page-load', initCookieBanner);
</script>
