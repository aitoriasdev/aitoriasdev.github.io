---
import Icon from './Icon.astro';
---

<!-- Floating Cookie Trigger Button -->
<button
  id="cookie-reopen-btn"
  type="button"
  class="fixed bottom-5 left-5 z-40 hidden items-center justify-center gap-2 rounded-full border border-surface-light bg-bg-light p-3 text-text-light shadow-xl backdrop-blur-md transition-all duration-300 hover:border-accent-primary hover:text-accent-primary dark:border-surface-dark dark:bg-bg-dark dark:text-text-dark"
  aria-label="Manage cookie settings"
>
  <span>Cookies</span>
  <Icon name="cookie" class="h-5 w-5" />
</button>

<!-- Main Cookie Banner (Positioned on the Left) -->
<div
  id="cookie-banner"
  class="fixed bottom-4 left-4 right-4 z-50 hidden max-w-md rounded-2xl border border-surface-light bg-bg-light/95 p-5 shadow-2xl backdrop-blur-md dark:border-surface-dark dark:bg-bg-dark/95 md:right-auto"
  role="region"
  aria-label="Cookie consent banner"
>
  <div class="flex items-start justify-between gap-2">
    <div class="flex items-center gap-2">
      <p class="text-sm font-semibold text-text-light dark:text-text-dark">
        Cookie Settings
      </p>
      <!-- Live Status Badge -->
      <span
        id="cookie-status-badge"
        class="hidden rounded-full px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider"
      ></span>
    </div>

    <!-- Banner Close Button -->
    <button
      id="btn-close-banner"
      type="button"
      class="rounded-lg p-1 text-text-muted-light transition-colors hover:bg-surface-light hover:text-text-light dark:text-text-muted-dark dark:hover:bg-surface-dark dark:hover:text-text-dark"
      aria-label="Close cookie banner"
    >
      <Icon name="close" class="h-4 w-4" />
    </button>
  </div>

  <p class="mt-2 text-xs text-text-muted-light dark:text-text-muted-dark">
    We use cookies to ensure basic site functionality and measure traffic to improve your experience.
  </p>

  <!-- Cookie Details Section -->
  <details class="group mt-3 border-t border-surface-light pt-3 text-xs dark:border-surface-dark">
    <summary class="cursor-pointer font-medium text-accent-primary hover:underline focus:outline-none">
      View Cookie Details
    </summary>

    <div class="mt-2 space-y-2 text-text-muted-light dark:text-text-muted-dark">
      <div class="rounded-lg bg-surface-light/50 p-2 dark:bg-surface-dark/50">
        <div class="flex items-center justify-between font-semibold text-text-light dark:text-text-dark">
          <span>Essential (Always Active)</span>
          <span class="text-[10px] text-accent-primary">Required</span>
        </div>
        <p class="mt-1 text-[11px]">
          <strong class="font-medium">analytics-consent:</strong> Stores your cookie consent preference locally in your browser.
        </p>
      </div>

      <div class="rounded-lg bg-surface-light/50 p-2 dark:bg-surface-dark/50">
        <div class="flex items-center justify-between font-semibold text-text-light dark:text-text-dark">
          <span>Analytics (Optional)</span>
          <span class="text-[10px] text-text-muted-light dark:text-text-muted-dark">Google Analytics</span>
        </div>
        <p class="mt-1 text-[11px]">
          <strong class="font-medium">_ga, _ga_*:</strong> Used by Google Analytics to collect anonymous information about how visitors use the site.
        </p>
      </div>
    </div>
  </details>

  <div class="mt-4 flex items-center justify-end gap-3">
    <button
      id="btn-deny"
      type="button"
      class="rounded-xl px-4 py-2 text-xs font-semibold text-text-muted-light transition-colors hover:bg-surface-light dark:text-text-muted-dark dark:hover:bg-surface-dark"
    >
      Deny
    </button>
    <button
      id="btn-accept"
      type="button"
      class="rounded-xl bg-accent-primary px-4 py-2 text-xs font-semibold text-white transition-opacity hover:opacity-90 dark:text-bg-dark"
    >
      Accept
    </button>
  </div>
</div>

<script is:inline>
  function initCookieBanner() {
    const banner = document.getElementById('cookie-banner');
    const reopenBtn = document.getElementById('cookie-reopen-btn');
    const closeBtn = document.getElementById('btn-close-banner');
    const statusBadge = document.getElementById('cookie-status-badge');
    const acceptBtn = document.getElementById('btn-accept');
    const denyBtn = document.getElementById('btn-deny');

    function updateUI(consent) {
      if (!statusBadge || !reopenBtn || !banner) return;

      if (consent) {
        statusBadge.className = 'rounded-full px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider';

        if (consent === 'granted') {
          statusBadge.textContent = 'Accepted';
          statusBadge.classList.add('bg-emerald-100', 'text-emerald-800', 'dark:bg-emerald-950', 'dark:text-emerald-300');
        } else {
          statusBadge.textContent = 'Denied';
          statusBadge.classList.add('bg-rose-100', 'text-rose-800', 'dark:bg-rose-950', 'dark:text-rose-300');
        }

        // Show floating button and hide main banner when consent is already recorded
        banner.classList.add('hidden');
        reopenBtn.classList.remove('hidden');
        reopenBtn.classList.add('flex');
      } else {
        // First visit: Display banner only
        banner.classList.remove('hidden');
        reopenBtn.classList.add('hidden');
        reopenBtn.classList.remove('flex');
        statusBadge.classList.add('hidden');
      }
    }

    function setConsent(value) {
      localStorage.setItem('analytics-consent', value);
      updateUI(value);

      if (typeof window.gtag === 'function') {
        window.gtag('consent', 'update', {
          analytics_storage: value,
        });
      }
    }

    acceptBtn?.addEventListener('click', () => setConsent('granted'));
    denyBtn?.addEventListener('click', () => setConsent('denied'));

    // Closing the banner switches back to the floating button state if a decision exists
    closeBtn?.addEventListener('click', () => {
      const currentConsent = localStorage.getItem('analytics-consent');
      if (currentConsent) {
        banner?.classList.add('hidden');
        reopenBtn?.classList.remove('hidden');
        reopenBtn?.classList.add('flex');
      } else {
        banner?.classList.add('hidden');
      }
    });

    // Opening banner hides the floating button
    reopenBtn?.addEventListener('click', () => {
      reopenBtn.classList.add('hidden');
      reopenBtn.classList.remove('flex');
      banner?.classList.remove('hidden');
    });

    const currentConsent = localStorage.getItem('analytics-consent');
    updateUI(currentConsent);
  }

  initCookieBanner();
  document.addEventListener('astro:page-load', initCookieBanner);
</script>
