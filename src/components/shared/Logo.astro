---
import Link from './Link.astro';
import { getLangFromUrl, useTranslatedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
---

<Link href={translatePath('/')} variant="menu" class="text-xl font-bold tracking-tight text-text-main-light dark:text-text-main-dark">
  aitorias<span class="text-accent-primary dark:text-accent-primary-dark">.dev</span>
</Link>
