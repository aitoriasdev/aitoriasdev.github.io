---
import Icon from './Icon.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!-- Trigger Button Positioned at Bottom-Left -->
<button
  id="a11y-trigger"
  type="button"
  class="fixed bottom-20 left-5 z-30 flex items-center gap-2 rounded-full border border-surface-light bg-bg-light/95 p-3 text-text-main-light shadow-xl backdrop-blur-md transition-transform motion-reduce:transform-none hover:scale-105 dark:border-surface-dark dark:bg-bg-dark/95 dark:text-text-main-dark"
  aria-label={t('a11y.open')}
  aria-expanded="false"
>
  <Icon name="accessibility" class="h-5 w-5" />
  <span class="sr-only">{t('a11y.title')}</span>
</button>

<!-- Accessibility Controls Panel -->
<div
  id="a11y-panel"
  class="fixed bottom-20 left-4 right-4 z-40 hidden max-w-md rounded-2xl border border-surface-light bg-bg-light/95 p-5 shadow-2xl backdrop-blur-md dark:border-surface-dark dark:bg-bg-dark/95 md:right-auto"
  role="region"
  aria-label={t('a11y.title')}
>
  <div class="flex items-center gap-4 justify-between border-b border-surface-light pb-2 dark:border-surface-dark">
    <h3 class="text-md font-bold uppercase tracking-wider text-text-main-light dark:text-text-main-dark">
      {t('a11y.title')}
    </h3>
    <button
      id="a11y-close"
      type="button"
      class="rounded-lg p-1 text-text-muted-light transition-colors motion-reduce:transition-none hover:bg-surface-light dark:text-text-muted-dark dark:hover:bg-surface-dark"
      aria-label={t('a11y.close')}
    >
      <Icon name="close" class="h-4 w-4" />
    </button>
  </div>

  <div class="mt-3 flex flex-col gap-2">
    <!-- Reduce Motion Toggle -->
    <button
      id="toggle-motion"
      type="button"
      class="a11y-btn flex items-center justify-between rounded-xl bg-surface-light/60 p-2 text-md font-semibold text-text-main-light transition-colors motion-reduce:transition-none hover:bg-surface-light dark:bg-surface-dark/60 dark:text-text-main-dark dark:hover:bg-surface-dark"
    >
      <span>{t('a11y.motion')}</span>
      <span class="status-indicator text-md uppercase font-bold text-rose-500 dark:text-rose-400" data-label-on={t('a11y.on')} data-label-off={t('a11y.off')}>{t('a11y.off')}</span>
    </button>

    <!-- High Contrast Toggle -->
    <button
      id="toggle-contrast"
      type="button"
      class="a11y-btn flex items-center justify-between rounded-xl bg-surface-light/60 p-2 text-md font-semibold text-text-main-light transition-colors motion-reduce:transition-none hover:bg-surface-light dark:bg-surface-dark/60 dark:text-text-main-dark dark:hover:bg-surface-dark"
    >
      <span>{t('a11y.contrast')}</span>
      <span class="status-indicator text-md uppercase font-bold text-rose-500 dark:text-rose-400" data-label-on={t('a11y.on')} data-label-off={t('a11y.off')}>{t('a11y.off')}</span>
    </button>

    <!-- Large Text Toggle -->
    <button
      id="toggle-text"
      type="button"
      class="a11y-btn flex items-center justify-between rounded-xl bg-surface-light/60 p-2 text-md font-semibold text-text-main-light transition-colors motion-reduce:transition-none hover:bg-surface-light dark:bg-surface-dark/60 dark:text-text-main-dark dark:hover:bg-surface-dark"
    >
      <span>{t('a11y.text')}</span>
      <span class="status-indicator text-md uppercase font-bold text-rose-500 dark:text-rose-400" data-label-on={t('a11y.on')} data-label-off={t('a11y.off')}>{t('a11y.off')}</span>
    </button>

    <!-- Dyslexic Font Toggle -->
    <button
      id="toggle-dyslexic"
      type="button"
      class="a11y-btn flex items-center justify-between rounded-xl bg-surface-light/60 p-2 text-md font-semibold text-text-main-light transition-colors motion-reduce:transition-none hover:bg-surface-light dark:bg-surface-dark/60 dark:text-text-main-dark dark:hover:bg-surface-dark"
    >
      <span>{t('a11y.dyslexic')}</span>
      <span class="status-indicator text-md uppercase font-bold text-rose-500 dark:text-rose-400" data-label-on={t('a11y.on')} data-label-off={t('a11y.off')}>{t('a11y.off')}</span>
    </button>
  </div>
</div>

<script is:inline>
  function initA11yMenu() {
    const trigger = document.getElementById('a11y-trigger');
    const panel = document.getElementById('a11y-panel');
    const closeBtn = document.getElementById('a11y-close');

    const toggles = {
      'reduce-motion': { btn: document.getElementById('toggle-motion'), class: 'reduce-motion' },
      'high-contrast': { btn: document.getElementById('toggle-contrast'), class: 'high-contrast' },
      'large-text': { btn: document.getElementById('toggle-text'), class: 'large-text' },
      'dyslexic-font': { btn: document.getElementById('toggle-dyslexic'), class: 'dyslexic-font' }
    };

    // Load saved preferences
    Object.keys(toggles).forEach((key) => {
      const isEnabled = localStorage.getItem(`a11y-${key}`) === 'true';

      if (isEnabled) {
        document.documentElement.classList.add(toggles[key].class);
      }
      updateBtnUI(toggles[key].btn, isEnabled);
    });

    function updateBtnUI(button, enabled) {
      if (!button) return;

      const indicator = button.querySelector('.status-indicator');

      if (indicator) {
        const labelOn = indicator.getAttribute('data-label-on') || 'On';
        const labelOff = indicator.getAttribute('data-label-off') || 'Off';

        indicator.textContent = enabled ? labelOn : labelOff;
        indicator.className = `status-indicator text-md uppercase font-bold ${
          enabled ? 'text-accent-primary' : 'text-rose-500 dark:text-rose-400'
        }`;
      }
    }

    function closePanel() {
      panel?.classList.add('hidden');
      trigger?.setAttribute('aria-expanded', 'false');
    }

    // Toggle menu panel
    trigger?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isHidden = panel?.classList.contains('hidden');

      if (isHidden) {
        panel?.classList.remove('hidden');
        trigger.setAttribute('aria-expanded', 'true');
      } else {
        closePanel();
      }
    });

    closeBtn?.addEventListener('click', closePanel);

    // Close on click outside
    document.addEventListener('click', (event) => {
      if (
        panel &&
        !panel.classList.contains('hidden') &&
        !panel.contains(event.target) &&
        !trigger?.contains(event.target)
      ) {
        closePanel();
      }
    });

    // Attach listeners for options
    Object.keys(toggles).forEach((key) => {
      const item = toggles[key];

      item.btn?.addEventListener('click', () => {
        const isCurrentlyActive = document.documentElement.classList.contains(item.class);
        const newState = !isCurrentlyActive;

        if (newState) {
          document.documentElement.classList.add(item.class);
        } else {
          document.documentElement.classList.remove(item.class);
        }

        localStorage.setItem(`a11y-${key}`, String(newState));
        updateBtnUI(item.btn, newState);
      });
    });
  }

  initA11yMenu();
  document.addEventListener('astro:page-load', initA11yMenu);
</script>
