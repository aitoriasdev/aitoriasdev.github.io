---
// Icon.astro
export type IconName =
  | 'github'
  | 'linkedin'
  | 'x'
  | 'external'
  | 'close'
  | 'menu'
  | 'sun'
  | 'moon'
  | 'system'
  | 'broken-image'
  | 'cookie'
  | 'accessibility'
  | 'arrow-left'
  | 'chevron-down';

interface Props {
  name: IconName;
  class?: string;
  'aria-hidden'?: boolean | 'true' | 'false';
}

const { name, class: className = 'h-4 w-4', 'aria-hidden': ariaHidden = true } = Astro.props;
