---
export type IconName =
  | 'github'
  | 'linkedin'
  | 'x'
  | 'external'
  | 'close'
  | 'menu'
  | 'sun'
  | 'moon'
  | 'system'
  | 'broken-image'
  | 'cookie';

interface Props {
  name: IconName;
  class?: string;
  'aria-hidden'?: boolean | 'true' | 'false';
}

const { name, class: className = 'h-4 w-4', 'aria-hidden': ariaHidden = true } = Astro.props;
---

{name === 'github' && (
  <svg class:list={['fill-current', className]} viewBox="0 0 24 24" aria-hidden={ariaHidden}>
    <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
  </svg>
)}

{name === 'linkedin' && (
  <svg class:list={['fill-current', className]} viewBox="0 0 24 24" aria-hidden={ariaHidden}>
    <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.7a1.63 1.63 0 1 0 0 3.26 1.63 1.63 0 0 0 0-3.26z" />
  </svg>
)}

{name === 'x' && (
  <svg class:list={['fill-current', className]} viewBox="0 0 24 24" aria-hidden={ariaHidden}>
    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
  </svg>
)}

{name === 'external' && (
  <svg class:list={['stroke-current', className]} fill="none" viewBox="0 0 24 24" stroke-width="2" aria-hidden={ariaHidden}>
    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H18m0 0v4.5M18 6l-7.5 7.5M10.5 6H7.5A2.25 2.25 0 005.25 8.25v10.5A2.25 2.25 0 007.5 21h10.5a2.25 2.25 0 002.25-2.25V15" />
  </svg>
)}

{name === 'close' && (
  <svg class:list={['stroke-current', className]} fill="none" viewBox="0 0 24 24" stroke-width="2" aria-hidden={ariaHidden}>
    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
  </svg>
)}

{name === 'sun' && (
  <svg class:list={['stroke-current', className]} fill="none" viewBox="0 0 24 24" stroke-width="2" aria-hidden={ariaHidden}>
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
  </svg>
)}

{name === 'moon' && (
  <svg class:list={['stroke-current', className]} fill="none" viewBox="0 0 24 24" stroke-width="2" aria-hidden={ariaHidden}>
    <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
  </svg>
)}

{name === 'system' && (
  <svg class:list={['stroke-current', className]} fill="none" viewBox="0 0 24 24" stroke-width="2" aria-hidden={ariaHidden}>
    <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
  </svg>
)}

{name === 'broken-image' && (
  <svg class:list={['stroke-current', className]} fill="none" viewBox="0 0 24 24" stroke-width="1.5" aria-hidden={ariaHidden}>
    <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
  </svg>
)}

{name === 'cookie' && (
  <svg class:list={['fill-current', className]} viewBox="0 0 24 24" aria-hidden={ariaHidden}>
    <path d="M21.598 11.064a1.006 1.006 0 0 0-.854-.172A3.993 3.993 0 0 1 15 7a3.993 3.993 0 0 1-3.892-5.744 1.006 1.006 0 0 0-.172-.854A10.001 10.001 0 1 0 21.598 11.064zM8.5 15.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm2-6a1 1 0 1 1 0-2 1 1 0 0 1 0 2zm4.5 7.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2zm1-5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z"/>
  </svg>
)}
