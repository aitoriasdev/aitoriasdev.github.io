---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  isExternal?: boolean;
  variant?: 'default' | 'menu' | 'subtle' | 'button-primary' | 'button-secondary';
  class?: string;
}

const {
  href,
  isExternal = false,
  variant = 'default',
  class: className = '',
  ...rest
} = Astro.props;

const isOutbound = isExternal || href.startsWith('http');

const variants = {
  default:
    'text-md font-medium text-accent-primary hover:underline dark:text-accent-primary-dark',
  menu:
    'relative py-1 text-lg font-medium no-underline text-text-main-light hover:text-text-main-light dark:text-text-muted-dark dark:hover:text-text-main-dark',
  subtle:
    'text-md text-text-muted-light hover:text-text-main-light dark:text-text-muted-dark dark:hover:text-text-main-dark',
  'button-primary':
    'inline-flex items-center justify-center gap-2 rounded-xl bg-accent-primary px-5 py-3 text-md font-semibold text-white dark:text-bg-dark shadow-sm hover:opacity-90 cursor-default select-none',
  'button-secondary':
    'inline-flex items-center justify-center gap-2 rounded-xl bg-surface-light px-5 py-3 text-md font-semibold text-text-main-light shadow-sm hover:bg-bg-light dark:bg-surface-dark dark:text-text-main-dark dark:hover:bg-bg-dark cursor-default select-none',
};
---

<a
  href={href}
  target={isOutbound ? '_blank' : undefined}
  rel={isOutbound ? 'noopener noreferrer' : undefined}
  class:list={[
    'transition-colors motion-reduce:transition-none focus-visible:outline-2 focus-visible:outline-accent-primary',
    variants[variant],
    className,
  ]}
  {...rest}
>
  <slot />
  {
    isOutbound && (
      <span class="sr-only"> (opens in a new tab)</span>
    )
  }
</a>
