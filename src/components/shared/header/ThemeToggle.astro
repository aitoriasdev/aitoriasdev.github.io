---
import Icon from '../../shared/Icon.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="relative inline-flex items-center rounded-full bg-surface-light p-1 shadow-inner dark:bg-surface-dark">
  <button
    type="button"
    data-theme-value="light"
    aria-label={t('theme.light')}
    class="theme-btn flex h-7 w-7 items-center justify-center rounded-full text-text-muted-light transition-all motion-reduce:transition-none hover:text-text-main-light focus-visible:outline-2 focus-visible:outline-accent-primary dark:text-text-muted-dark dark:hover:text-text-main-dark"
  >
    <Icon name="sun" class="h-4 w-4" />
  </button>
  <button
    type="button"
    data-theme-value="dark"
    aria-label={t('theme.dark')}
    class="theme-btn flex h-7 w-7 items-center justify-center rounded-full text-text-muted-light transition-all motion-reduce:transition-none hover:text-text-main-light focus-visible:outline-2 focus-visible:outline-accent-primary dark:text-text-muted-dark dark:hover:text-text-main-dark"
  >
    <Icon name="moon" class="h-4 w-4" />
  </button>
  <button
    type="button"
    data-theme-value="system"
    aria-label={t('theme.system')}
    class="theme-btn flex h-7 w-7 items-center justify-center rounded-full text-text-muted-light transition-all motion-reduce:transition-none hover:text-text-main-light focus-visible:outline-2 focus-visible:outline-accent-primary dark:text-text-muted-dark dark:hover:text-text-main-dark"
  >
    <Icon name="system" class="h-4 w-4" />
  </button>
</div>

<script>
  type Theme = 'light' | 'dark' | 'system';

  function initThemeToggle() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.theme-btn');

    if (!buttons.length) return;

    const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');

    function getStoredTheme(): Theme {
      return (localStorage.getItem('theme') as Theme) || 'system';
    }

    function applyTheme(theme: Theme) {
      const isDark = theme === 'dark' || (theme === 'system' && mediaQuery.matches);

      document.documentElement.classList.toggle('dark', isDark);

      buttons.forEach((button) => {
        const val = button.getAttribute('data-theme-value');

        const isActive = val === theme;

        button.classList.toggle('bg-bg-light', isActive);
        button.classList.toggle('dark:bg-bg-dark', isActive);
        button.classList.toggle('text-accent-primary', isActive);
        button.classList.toggle('shadow-sm', isActive);

        button.classList.toggle('text-text-muted-light', !isActive);
        button.classList.toggle('dark:text-text-muted-dark', !isActive);
      });
    }

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const val = button.getAttribute('data-theme-value') as Theme;

        localStorage.setItem('theme', val);
        applyTheme(val);
      });
    });

    mediaQuery.addEventListener('change', () => {
      if (getStoredTheme() === 'system') {
        applyTheme('system');
      }
    });

    applyTheme(getStoredTheme());
  }

  initThemeToggle();
  document.addEventListener('astro:page-load', initThemeToggle);
</script>
