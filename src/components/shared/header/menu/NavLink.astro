---
import Link from '../../../shared/Link.astro';
import { getLangFromUrl, useTranslatedPath } from '../../../../i18n/utils';

interface Props {
  href: string;
  label: string;
  variant?: 'desktop' | 'mobile';
}

const { href, label, variant = 'desktop' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);

const localizedHref = translatePath(href);

const normalizePath = (path: string) => path.replace(/\/+$/, '') || '/';

const currentPath = normalizePath(Astro.url.pathname);
const targetPath = normalizePath(localizedHref);

const isActive =
  currentPath === targetPath ||
  (targetPath !== '/' && currentPath.startsWith(`${targetPath}/`));
---

{
  variant === 'mobile' ? (
    <Link
      href={localizedHref}
      variant="subtle"
      aria-current={isActive ? 'page' : undefined}
      class:list={[
        'mobile-nav-link block w-full rounded-xl px-4 py-3 text-lg font-semibold transition-all motion-reduce:transition-none no-underline hover:no-underline',
        isActive
          ? 'bg-accent-primary text-bg-light dark:text-bg-dark'
          : 'text-text-main-light hover:bg-surface-light hover:text-text-main-light dark:text-text-muted-dark dark:hover:bg-surface-dark dark:hover:text-text-main-dark',
      ]}
    >
      {label}
    </Link>
  ) : (
    <Link
      href={localizedHref}
      variant={isActive ? 'default' : 'menu'}
      aria-current={isActive ? 'page' : undefined}
      class:list={[
        isActive && 'text-lg font-bold no-underline',
      ]}
    >
      {label}
    </Link>
  )
}
