---
import Button from '../../../shared/Button.astro';
import { getLangFromUrl, useTranslations } from '../../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Button
  id="mobile-menu-toggle"
  variant="ghost"
  size="sm"
  class="relative z-50 inline-flex items-center gap-2 md:hidden"
  aria-label={t('nav.toggleMenu')}
  aria-expanded="false"
>
  <div class="relative inline-flex h-4 w-4 flex-col justify-center gap-1" aria-hidden="true">
    <span id="bar-top" class="h-0.5 w-full origin-center rounded-full bg-current transition-all duration-300 motion-reduce:transition-none"></span>
    <span id="bar-mid" class="h-0.5 w-full rounded-full bg-current transition-all duration-300 motion-reduce:transition-none"></span>
    <span id="bar-bot" class="h-0.5 w-full origin-center rounded-full bg-current transition-all duration-300 motion-reduce:transition-none"></span>
  </div>
  <span class="sr-only text-md font-semibold tracking-wide text-text-main-light dark:text-text-main-dark">
    {t('nav.menu')}
  </span>
</Button>
