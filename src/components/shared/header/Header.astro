---
import Logo from '../../shared/Logo.astro';
import NavMenu from './menu/NavMenu.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="sticky top-0 z-30 w-full bg-bg-light/85 shadow-sm backdrop-blur-md transition-shadow duration-200 dark:bg-bg-dark/85 dark:shadow-md dark:shadow-black/20">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <Logo />
    <NavMenu />
    <ThemeToggle />
  </div>
</header>
