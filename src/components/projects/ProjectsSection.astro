---
import { getCollection, type CollectionEntry } from 'astro:content';
import ProjectCard from './project-card/ProjectCard.astro';
import ProjectFilters from './ProjectFilters.astro';
import Link from '../shared/Link.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';

interface Props {
  showViewAll?: boolean;
}

const { showViewAll = false } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const allProjects = await getCollection('projects');
// Filter projects matching current language
const projects = allProjects.filter((p) => p.data.lang === lang);
const projectCount = projects.length;
---

<section id="projects" class="mx-auto max-w-5xl px-6 py-10 lg:py-20" aria-labelledby="projects-heading">
  <!-- Section Title & Filters -->
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h2 id="projects-heading" class="text-3xl font-extrabold tracking-tight text-text-main-light sm:text-3xl dark:text-text-main-dark">
        {t('projects.title')}
      </h2>
      <p class="mt-1 text-md text-text-muted-light dark:text-text-muted-dark">
        {t('projects.subtitle')}
      </p>
    </div>
    <div class="flex items-center gap-4">
      <ProjectFilters />
    </div>
  </div>
  <!-- Dynamic Adaptive Grid Container -->
  <div
    class:list={[
      'mt-10 grid gap-6',
      projectCount === 1 && 'grid-cols-1 max-w-lg mx-auto',
      projectCount === 2 && 'grid-cols-1 lg:grid-cols-2',
      projectCount >= 3 && 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3'
    ]}
  >
    {projects.map((project: CollectionEntry<'projects'>, index: number) => (
      <ProjectCard project={project} isLcp={index === 0} />
    ))}
  </div>
  <div class="mt-5">
    {/* Conditionally render the "View All" link with localized route */}
      {showViewAll && (
        <Link
          href={translatePath('/projects')}
          variant="button-secondary"
          data-track-event="view_all_projects_click"
        >
          <span>{t('projects.viewAll')}</span>
        </Link>
      )}
  </div>
</section>
