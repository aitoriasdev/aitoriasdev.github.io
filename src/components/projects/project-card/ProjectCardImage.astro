---
import { Image } from 'astro:assets';
import Icon from '../../shared/Icon.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  alt: string;
  isLcp?: boolean;
}

const { src, alt, isLcp = false } = Astro.props;
---

<div class="relative aspect-2/1 lg:aspect-3/2 w-full overflow-hidden bg-bg-light shadow-inner dark:bg-bg-dark">
  {
    src ? (
      <Image
        src={src}
        alt={alt}
        widths={[600, 900, 1200, 1600]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        loading={isLcp ? 'eager' : 'lazy'}
        fetchpriority={isLcp ? 'high' : 'auto'}
        decoding={isLcp ? 'sync' : 'async'}
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    ) : (
      <div class="flex h-full w-full flex-col items-center justify-center gap-2 bg-surface-light/40 text-text-muted-light dark:bg-surface-dark/40 dark:text-text-muted-dark">
        <Icon name="broken-image" class="h-8 w-8 opacity-50" />
        <span class="text-xs font-medium tracking-wide">No preview available</span>
      </div>
    )
  }
</div>
