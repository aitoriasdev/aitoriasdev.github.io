---
import Badge from '../../shared/Badge.astro';
import Link from '../../shared/Link.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../../i18n/utils';

interface Props {
  id: string;
  title: string;
  description: string;
  tags: string[];
}

const { id, title, description, tags } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// Extract clean ID if it contains folder prefix like 'es/aitorias-dev'
const cleanId = id.includes('/') ? id.split('/').pop() : id;
---

<div class="flex flex-col gap-4">
  <ul class="flex flex-wrap gap-1.5" aria-label={t('projects.techUsedAria')}>
    {tags.map((tag) => (
      <li>
        <Badge variant="surface">{tag}</Badge>
      </li>
    ))}
  </ul>
  <h3 class="text-lg font-bold">
    <Link
      href={translatePath(`/projects/${cleanId}`)}
      aria-label={`${t('projects.viewDetailsAria')} ${title}`}
      data-track-event={`project_details_click_${cleanId}`}
    >
      {title}
    </Link>
  </h3>
  <p class="text-md leading-relaxed text-text-muted-light dark:text-text-muted-dark">
    {description}
  </p>
</div>
