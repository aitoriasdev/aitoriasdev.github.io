---
import Badge from '../../shared/Badge.astro';
import Link from '../../shared/Link.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';

interface Props {
  href: string;
  slug: string;
  title: string;
  description: string;
  tags: string[];
}

const { href, slug, title, description, tags } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!-- Title, a short teaser and the headline technologies: the same shape on every card keeps the grid even -->
<div class="flex flex-col gap-3">
  <h3 class="text-lg font-bold">
    <Link
      href={href}
      aria-label={`${t('projects.viewDetailsAria')} ${title}`}
      data-track-event={`project_details_click_${slug}`}
    >
      {title}
    </Link>
  </h3>
  <!-- Clamped to three lines (screen readers still get it all); the full text is on the project page -->
  <p class="line-clamp-3 text-base leading-relaxed text-text-muted-light dark:text-text-muted-dark">
    {description}
  </p>
  <ul class="mt-1 flex flex-wrap gap-1.5" aria-label={t('projects.techUsedAria')}>
    {tags.map((tag) => (
      <li>
        <Badge variant="surface">{tag}</Badge>
      </li>
    ))}
  </ul>
</div>
