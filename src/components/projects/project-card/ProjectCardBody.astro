---
import Badge from '../../shared/Badge.astro';
import Link from '../../shared/Link.astro';

interface Props {
  id: string;
  title: string;
  description: string;
  tags: string[];
}

const { id, title, description, tags } = Astro.props;
---

<div class="flex flex-col gap-4">
  <ul class="flex flex-wrap gap-1.5" aria-label="Technologies used">
    {tags.map((tag) => (
      <li>
        <Badge variant="surface">{tag}</Badge>
      </li>
    ))}
  </ul>
  <h3 class="text-lg font-bold">
    <Link href={`/projects/${id}`} aria-label={`View details for ${title}`}>
      {title}
    </Link>
  </h3>
  <p class="text-md leading-relaxed text-text-muted-light dark:text-text-muted-dark">
    {description}
  </p>
</div>
