---
import Icon from '../../ui/Icon.astro';
import Link from '../../ui/Link.astro';

interface Props {
  githubUrl: string;
  liveUrl?: string;
  title: string;
}

const { githubUrl, liveUrl, title } = Astro.props;
---

<div class="flex items-center gap-3 pt-2">
  <Link href={githubUrl} isExternal variant="button-secondary">
    <Icon name="github" class="h-3.5 w-3.5" />
    <span>GitHub</span>
    <span class="sr-only"> repository for {title}</span>
    <Icon name="external" class="h-3.5 w-3.5" />
  </Link>

  {liveUrl && (
    <Link href={liveUrl} isExternal variant="button-primary">
      <span>Live Demo</span>
      <span class="sr-only"> for {title}</span>
      <Icon name="external" class="h-3.5 w-3.5" />
    </Link>
  )}
</div>
