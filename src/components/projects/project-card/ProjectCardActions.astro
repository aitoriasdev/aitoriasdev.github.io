---
import Icon from '../../shared/Icon.astro';
import Link from '../../shared/Link.astro';

interface Props {
  id: string;
  gitHubUrl?: string;
  liveUrl?: string;
  title: string;
}

const { id, gitHubUrl, liveUrl, title } = Astro.props;
---

<div class="flex w-full flex-wrap items-center justify-between gap-4 sm:flex-nowrap">
  <!-- Left Side: Details Link -->
  <Link href={`/projects/${id}`} aria-label={`View details for ${title}`}>
    <span>Project details</span>
  </Link>

  <!-- Right Side: External Navigation Links -->
  <div class="flex w-full flex-wrap items-center justify-between gap-2 sm:w-auto">
    {gitHubUrl && (
      <Link href={gitHubUrl} isExternal variant="button-secondary">
        <Icon name="github" class="h-3.5 w-3.5" />
        <span>GitHub</span>
        <span class="sr-only"> repository for {title}</span>
        <Icon name="external" class="h-3.5 w-3.5" />
      </Link>
    )}
    {liveUrl && (
      <Link href={liveUrl} isExternal variant="button-primary">
        <span>Live demo</span>
        <Icon name="external" class="h-3.5 w-3.5" />
      </Link>
    )}
  </div>
</div>
