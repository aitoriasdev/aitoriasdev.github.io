---
import Icon from '../../shared/Icon.astro';
import Link from '../../shared/Link.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';

interface Props {
  id: string;
  gitHubUrl?: string;
  liveUrl?: string;
  title: string;
}

const { gitHubUrl, liveUrl, title } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="flex w-full items-center gap-2">
  {gitHubUrl && (
    <Link href={gitHubUrl} isExternal variant="button-outline">
      <Icon name="github" class="h-3.5 w-3.5" />
      <span>GitHub</span>
      <span class="sr-only"> {t('projects.repoSrOnly')} {title}</span>
      <Icon name="external" class="h-3.5 w-3.5" />
    </Link>
  )}
  {liveUrl && (
    <Link href={liveUrl} isExternal variant="button-primary">
      <span>{t('projects.liveDemo')}</span>
      <Icon name="external" class="h-3.5 w-3.5" />
    </Link>
  )}
</div>
