---
import Icon from '../../shared/Icon.astro';
import Link from '../../shared/Link.astro';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';

interface Props {
  id: string;
  gitHubUrl?: string;
  liveUrl?: string;
  title: string;
}

const { gitHubUrl, liveUrl, title } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="flex w-full items-stretch gap-2">
  {gitHubUrl && (
    <Link
      href={gitHubUrl}
      isExternal
      variant="button-outline"
      class="w-1/2"
      data-track-event={`project_github_click_${title.toLowerCase().replace(/\s+/g, '_')}`}
    >
      <Icon name="github" class="h-[1.125em] w-[1.125em] shrink-0" />
      <span>GitHub</span>
      <span class="sr-only"> {t('projects.repoSrOnly')} {title}</span>
      <Icon name="external" class="h-[1.125em] w-[1.125em] shrink-0" />
    </Link>
  )}
  {liveUrl && (
    <Link
      href={liveUrl}
      isExternal
      variant="button-primary"
      class="w-1/2"
      data-track-event={`project_demo_click_${title.toLowerCase().replace(/\s+/g, '_')}`}
    >
      <span>{t('projects.liveDemo')}</span>
      <Icon name="external" class="h-[1.125em] w-[1.125em] shrink-0" />
    </Link>
  )}
</div>
