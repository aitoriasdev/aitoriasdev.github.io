---
import ProjectCardActions from './ProjectCardActions.astro';
import ProjectCardBody from './ProjectCardBody.astro';
import ProjectCardImage from './ProjectCardImage.astro';
import { type CollectionEntry } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';

interface Props {
  project: CollectionEntry<'projects'>;
  isLcp?: boolean;
}

const { project, isLcp = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<article
  class="project-card group flex flex-col justify-between overflow-hidden rounded-2xl bg-surface-light/60 shadow-sm backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:bg-surface-light hover:shadow-xl dark:bg-surface-dark/60 dark:shadow-md dark:shadow-black/20 dark:hover:bg-surface-dark dark:hover:shadow-black/40 motion-reduce:transition-none motion-reduce:hover:translate-y-0 in-[.reduce-motion]:transition-none in-[.reduce-motion]:hover:translate-y-0"
  data-tags={JSON.stringify(project.data.techStack)}
>
  <!-- Full Width Image Container at Top -->
  <ProjectCardImage
    src={project.data.thumbnail}
    alt={`${t('projects.screenshotAlt')} ${project.data.title}`}
    isLcp={isLcp}
  />

  <!-- Padded Body Content -->
  <div class="flex flex-1 flex-col gap-6 justify-between p-5">
    <ProjectCardBody
      id={project.id}
      title={project.data.title}
      description={project.data.tagline}
      tags={project.data.techStack}
    />
    <ProjectCardActions
      id={project.id}
      gitHubUrl={project.data.gitHubUrl}
      liveUrl={project.data.liveUrl}
      title={project.data.title}
    />
  </div>
</article>
