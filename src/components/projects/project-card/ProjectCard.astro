---
import { Image } from 'astro:assets';
import Icon from './../../ui/Icon.astro';
import type { Project } from '../../../config/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article
  class="project-card group flex flex-col justify-between overflow-hidden rounded-2xl bg-surface-light/60 p-5 shadow-sm backdrop-blur-sm transition-all duration-300 hover:bg-surface-light hover:shadow-xl dark:bg-surface-dark/60 dark:shadow-md dark:shadow-black/20 dark:hover:bg-surface-dark dark:hover:shadow-black/40"
  data-tags={JSON.stringify(project.tags)}
>
  <div>
    <!-- Image Wrapper with Soft Shadow -->
    <div class="relative aspect-video w-full overflow-hidden rounded-xl bg-bg-light shadow-inner dark:bg-bg-dark">
      <Image
        src={project.image}
        alt={`Screenshot of ${project.title}`}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover transition-transform duration-500"
      />
    </div>

    <!-- Content -->
    <div class="pt-5">
      <h3 class="text-lg font-bold text-text-main-light dark:text-text-main-dark">
        {project.title}
      </h3>
      <p class="mt-2 text-xs leading-relaxed text-text-muted-light dark:text-text-muted-dark">
        {project.description}
      </p>
    </div>
  </div>

  <div class="mt-6 flex flex-col gap-4">
    <!-- Tech Stack Tags -->
    <ul class="flex flex-wrap gap-1.5" aria-label="Technologies used">
      {project.tags.map((tag) => (
        <li class="rounded-lg bg-bg-light/80 px-2.5 py-1 text-[11px] font-medium text-text-muted-light dark:bg-bg-dark/80 dark:text-text-muted-dark">
          {tag}
        </li>
      ))}
    </ul>

    <!-- Action Links -->
    <div class="flex items-center gap-3 pt-2">
      <a
        href={project.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-xl bg-bg-light px-3.5 py-2 text-xs font-semibold text-text-main-light shadow-sm transition-colors hover:bg-accent-primary hover:text-bg-light focus-visible:outline-2 focus-visible:outline-accent-primary dark:bg-bg-dark dark:text-text-main-dark dark:hover:bg-accent-primary dark:hover:text-bg-dark"
      >
        <Icon name="github" class="h-3.5 w-3.5" />
        <span>GitHub</span>
        <span class="sr-only"> repository for {project.title} (opens in new tab)</span>
        <Icon name="external" class="h-3.5 w-3.5" />
      </a>

      {project.liveUrl && (
        <a
          href={project.liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-xl bg-accent-primary px-3.5 py-2 text-xs font-semibold text-bg-light shadow-sm transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-accent-primary dark:text-bg-dark"
        >
          <span>Live Demo</span>
          <span class="sr-only"> for {project.title} (opens in new tab)</span>
          <Icon name="external" class="h-3.5 w-3.5" />
        </a>
      )}
    </div>
  </div>
</article>
