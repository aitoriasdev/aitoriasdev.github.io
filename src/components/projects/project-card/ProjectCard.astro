---
import ProjectCardActions from './ProjectCardActions.astro';
import ProjectCardBody from './ProjectCardBody.astro';
import ProjectCardImage from './ProjectCardImage.astro';
import { type CollectionEntry } from 'astro:content';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../../i18n/utils';
import { getProjectSlug } from '../../../utils/projects';

interface Props {
  project: CollectionEntry<'projects'>;
  isLcp?: boolean;
}

const { project, isLcp = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const slug = getProjectSlug(project);
const projectHref = translatePath(`/projects/${slug}`);
---

<article
  class="project-card group flex flex-col justify-between overflow-hidden rounded-2xl bg-surface-light/60 shadow-sm backdrop-blur-sm transition-all duration-300 hover:bg-surface-light hover:shadow-xl dark:bg-surface-dark/60 dark:shadow-md dark:shadow-black/20 dark:hover:bg-surface-dark dark:hover:shadow-black/40 motion-reduce:transition-none [.reduce-motion]:transition-none"
  data-tags={JSON.stringify(project.data.techStack)}
>
  <!-- Full Width Image Container at Top -->
  <ProjectCardImage
    src={project.data.thumbnail}
    alt={`${t('projects.screenshotAlt')} ${project.data.title}`}
    href={projectHref}
    slug={slug}
    title={project.data.title}
    isLcp={isLcp}
  />
  <!-- Padded Body Content -->
  <div class="flex flex-1 flex-col gap-6 justify-between p-5">
    <ProjectCardBody
      href={projectHref}
      slug={slug}
      title={project.data.title}
      description={project.data.tagline}
      tags={project.data.techStack}
    />
    <ProjectCardActions
      gitHubUrl={project.data.gitHubUrl}
      liveUrl={project.data.liveUrl}
      liveLabel={project.data.liveLabel}
      title={project.data.title}
    />
  </div>
</article>
