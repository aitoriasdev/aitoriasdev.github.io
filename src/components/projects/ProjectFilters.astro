---
import Button from '../shared/Button.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
  /** Technologies to offer as filters, derived from the rendered projects. */
  techs: string[];
}

const { techs } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div
  class="custom-scrollbar mt-6 -mx-6 flex items-center gap-2 overflow-x-auto px-6 pb-3 pt-1 sm:mx-0 sm:mt-0 sm:flex-wrap sm:overflow-x-visible sm:px-0 sm:pb-0 sm:pt-0"
  role="group"
  aria-label={t('projects.filterAria')}
>
  {/* Static "ALL" Filter Button */}
  <Button
    data-filter="All"
    data-active="true"
    variant="ghost"
    size="sm"
    class:list={[
      'filter-btn shrink-0 transition-all duration-200 motion-reduce:transition-none cursor-pointer',
      'data-[active=true]:bg-accent-primary data-[active=true]:text-white dark:data-[active=true]:text-bg-dark data-[active=true]:shadow-sm',
      'data-[active=false]:bg-surface-light/70 data-[active=false]:text-text-muted-light dark:data-[active=false]:bg-surface-dark/70 dark:data-[active=false]:text-text-muted-dark',
      'data-[active=false]:hover:bg-accent-primary/10 data-[active=false]:hover:text-accent-primary data-[active=false]:hover:border-accent-primary/30',
      'dark:data-[active=false]:hover:bg-accent-primary-dark/15 dark:data-[active=false]:hover:text-accent-primary-dark'
    ]}
    aria-pressed="true"
  >
    {t('projects.filterAll')}
  </Button>
  {/* Tech Stack Filter Buttons */}
  {techs.map((tech) => (
    <Button
      data-filter={tech}
      data-active="false"
      variant="ghost"
      size="sm"
      class:list={[
        'filter-btn shrink-0 transition-all duration-200 motion-reduce:transition-none cursor-pointer',
        'data-[active=true]:bg-accent-primary data-[active=true]:text-white dark:data-[active=true]:text-bg-dark data-[active=true]:shadow-sm',
        'data-[active=false]:bg-surface-light/70 data-[active=false]:text-text-muted-light dark:data-[active=false]:bg-surface-dark/70 dark:data-[active=false]:text-text-muted-dark',
        'data-[active=false]:hover:bg-accent-primary/10 data-[active=false]:hover:text-accent-primary data-[active=false]:hover:border-accent-primary/30',
        'dark:data-[active=false]:hover:bg-accent-primary-dark/15 dark:data-[active=false]:hover:text-accent-primary-dark'
      ]}
      aria-pressed="false"
    >
      {tech}
    </Button>
  ))}
</div>

<style is:global>
  /* Filtering animation (View Transitions API). Cards that stay slide to their
     new place, cards that leave shrink and fade out, and cards that arrive grow
     in. Browsers without the API, or visitors who ask for less motion, get the
     instant switch (see the script below). */
  ::view-transition-group(.project-card) {
    /* Clip to the card's shape so a resizing card never shows its old snapshot outside it */
    overflow: clip;
    border-radius: 1rem;
    animation-duration: 380ms;
    animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  ::view-transition-old(.project-card):only-child {
    animation: project-card-out 200ms ease-in both;
  }

  ::view-transition-new(.project-card):only-child {
    animation: project-card-in 340ms cubic-bezier(0.2, 0.8, 0.2, 1) 120ms both;
  }

  /* Keep the sticky header above cards moving underneath it */
  ::view-transition-group(site-header) {
    z-index: 1;
  }

  @keyframes project-card-out {
    to {
      opacity: 0;
      transform: scale(0.92);
    }
  }

  @keyframes project-card-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.92);
    }
  }
</style>

<script>
  const wantsLessMotion = () =>
    matchMedia('(prefers-reduced-motion: reduce)').matches ||
    document.documentElement.classList.contains('reduce-motion');

  function initProjectFilters() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const cards = document.querySelectorAll<HTMLElement>('.project-card');
    const emptyState = document.getElementById('projects-empty');

    if (!filterButtons.length || !cards.length) return;

    function showProjects(selectedTech: string) {
      let visibleCount = 0;

      cards.forEach((card) => {
        const cardTechs: string[] = JSON.parse(card.getAttribute('data-tags') || '[]');
        const isVisible = selectedTech === 'All' || cardTechs.includes(selectedTech);

        card.classList.toggle('hidden', !isVisible);
        if (isVisible) visibleCount++;
      });

      if (emptyState) {
        emptyState.textContent = visibleCount > 0 ? '' : (emptyState.dataset.message ?? '');
      }
    }

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        if (button.getAttribute('aria-pressed') === 'true') return;

        filterButtons.forEach((btn) => {
          const isSelected = btn === button;
          btn.setAttribute('data-active', String(isSelected));
          btn.setAttribute('aria-pressed', String(isSelected));
        });

        const update = () => showProjects(button.getAttribute('data-filter') ?? 'All');

        if (document.startViewTransition && !wantsLessMotion()) {
          document.startViewTransition(update);
        } else {
          update();
        }
      });
    });
  }

  initProjectFilters();
</script>
