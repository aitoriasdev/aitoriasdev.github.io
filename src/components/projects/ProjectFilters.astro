---
import Button from '../shared/Button.astro';
import { TECH_STACK } from '../../config/tech-stack';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div
  class="custom-scrollbar mt-6 -mx-6 flex items-center gap-2 overflow-x-auto px-6 pb-3 pt-1 sm:mx-0 sm:mt-0 sm:flex-wrap sm:overflow-x-visible sm:px-0 sm:pb-0 sm:pt-0"
  role="group"
  aria-label={t('projects.filterAria')}
>
  {/* Static "ALL" Filter Button */}
  <Button
    data-filter="All"
    data-active="true"
    variant="ghost"
    size="sm"
    class:list={[
      'filter-btn shrink-0 transition-all duration-200 motion-reduce:transition-none cursor-pointer',
      'data-[active=true]:bg-accent-primary data-[active=true]:text-white dark:data-[active=true]:bg-accent-primary-dark dark:data-[active=true]:text-bg-dark data-[active=true]:shadow-sm',
      'data-[active=false]:bg-surface-light/70 data-[active=false]:text-text-muted-light dark:data-[active=false]:bg-surface-dark/70 dark:data-[active=false]:text-text-muted-dark',
      'data-[active=false]:hover:bg-accent-primary/10 data-[active=false]:hover:text-accent-primary data-[active=false]:hover:border-accent-primary/30',
      'dark:data-[active=false]:hover:bg-accent-primary-dark/15 dark:data-[active=false]:hover:text-accent-primary-dark'
    ]}
    aria-pressed="true"
  >
    {t('projects.filterAll')}
  </Button>
  {/* Tech Stack Filter Buttons */}
  {TECH_STACK.map((tech) => (
    <Button
      data-filter={tech}
      data-active="false"
      variant="ghost"
      size="sm"
      class:list={[
        'filter-btn shrink-0 transition-all duration-200 motion-reduce:transition-none cursor-pointer',
        'data-[active=true]:bg-accent-primary data-[active=true]:text-white dark:data-[active=true]:bg-accent-primary-dark dark:data-[active=true]:text-bg-dark data-[active=true]:shadow-sm',
        'data-[active=false]:bg-surface-light/70 data-[active=false]:text-text-muted-light dark:data-[active=false]:bg-surface-dark/70 dark:data-[active=false]:text-text-muted-dark',
        'data-[active=false]:hover:bg-accent-primary/10 data-[active=false]:hover:text-accent-primary data-[active=false]:hover:border-accent-primary/30',
        'dark:data-[active=false]:hover:bg-accent-primary-dark/15 dark:data-[active=false]:hover:text-accent-primary-dark'
      ]}
      aria-pressed="false"
    >
      {tech}
    </Button>
  ))}
</div>

<script>
  function initProjectFilters() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const cards = document.querySelectorAll<HTMLElement>('.project-card');

    if (!filterButtons.length || !cards.length) return;

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const selectedTech = button.getAttribute('data-filter');

        filterButtons.forEach((btn) => {
          btn.setAttribute('data-active', 'false');
          btn.setAttribute('aria-pressed', 'false');
        });

        button.setAttribute('data-active', 'true');
        button.setAttribute('aria-pressed', 'true');

        cards.forEach((card) => {
          const cardTechs = JSON.parse(card.getAttribute('data-tags') || '[]');

          if (selectedTech === 'All' || cardTechs.includes(selectedTech)) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  }

  initProjectFilters();
  document.addEventListener('astro:page-load', initProjectFilters);
</script>
