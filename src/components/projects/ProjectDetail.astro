---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Badge from '../shared/Badge.astro';
import Breadcrumbs from '../shared/Breadcrumbs.astro';
import Icon from '../shared/Icon.astro';
import ImageLightbox from '../shared/ImageLightbox.astro';
import Layout from '../../layouts/Layout.astro';
import Link from '../shared/Link.astro';
import ProjectCardActions from './project-card/ProjectCardActions.astro';
import { SOCIAL_LINKS } from '../../config/social';
import { formatMonthYear, getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';
import { getProjectSlug, type Project } from '../../utils/projects';
import { getRepoStats } from '../../utils/github';
import { projectSchema } from '../../utils/structured-data';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const slug = getProjectSlug(project);

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const isActive = data.status === 'active';
const repoStats = await getRepoStats(data.gitHubUrl);
const timeline = data.startDate
  ? `${formatMonthYear(data.startDate, lang)} – ${
      data.completedDate ? formatMonthYear(data.completedDate, lang) : t('projects.present')
    }`
  : data.completedDate && formatMonthYear(data.completedDate, lang);

const site = Astro.site ?? new URL(Astro.url.origin);
const jsonLd = projectSchema(project, new URL(Astro.url.pathname, site), site, t('seo.jobTitle'));

const sectionHeading = 'text-2xl font-bold tracking-tight text-text-main-light dark:text-text-main-dark';
// Images open in the full-screen viewer (ImageLightbox); without JS they link to the full-size file
const zoomLink = 'group block cursor-zoom-in overflow-hidden bg-surface-light dark:bg-surface-dark';
const zoomImage = 'transition-transform duration-300 group-hover:scale-[1.02]';
---

<Layout
  title={`${data.title} | Aitorias`}
  description={data.tagline}
  author={data.author}
  image={data.thumbnail}
  imageAlt={`${t('projects.screenshotAlt')} ${data.title}`}
  type="article"
  jsonLd={jsonLd}
>
  <Breadcrumbs
    customCrumbs={[
      { label: t('nav.projects'), href: translatePath('/projects') },
      { label: data.title },
    ]}
  />

  <article class="mx-auto max-w-3xl px-6 pt-6 pb-16">
    <!-- Header -->
    <header class="flex flex-col gap-5">
      <Badge variant="status" class="self-start">
        <span
          class:list={[
            'inline-flex h-2 w-2 rounded-full',
            isActive ? 'bg-accent-primary' : 'bg-text-muted-light dark:bg-text-muted-dark',
          ]}
          aria-hidden="true"
        ></span>
        {t(`projects.status.${data.status}`)}
      </Badge>
      <h1 class="text-4xl font-bold tracking-tight text-text-main-light sm:text-5xl dark:text-text-main-dark">
        {data.title}
      </h1>
      <p class="text-lg leading-relaxed text-text-muted-light dark:text-text-muted-dark">
        {data.tagline}
      </p>

      {(data.role || timeline || repoStats) && (
        <dl class="grid gap-4 rounded-2xl bg-surface-light/60 p-5 sm:grid-cols-2 dark:bg-surface-dark/60">
          {data.role && (
            <div>
              <dt class="text-sm font-semibold uppercase tracking-wider text-text-muted-light dark:text-text-muted-dark">{t('projects.role')}</dt>
              <dd class="mt-1 font-semibold text-text-main-light dark:text-text-main-dark">{data.role}</dd>
            </div>
          )}
          {timeline && (
            <div>
              <dt class="text-sm font-semibold uppercase tracking-wider text-text-muted-light dark:text-text-muted-dark">{t('projects.timeline')}</dt>
              <dd class="mt-1 font-semibold text-text-main-light dark:text-text-main-dark">{timeline}</dd>
            </div>
          )}
          {repoStats?.latestRelease && (
            <div>
              <dt class="text-sm font-semibold uppercase tracking-wider text-text-muted-light dark:text-text-muted-dark">{t('projects.latestRelease')}</dt>
              <dd class="mt-1 font-semibold">
                <Link href={repoStats.latestRelease.url} isExternal data-track-event={`project_release_click_${slug}`}>
                  {repoStats.latestRelease.tag}
                </Link>
              </dd>
            </div>
          )}
          {repoStats?.pushedAt && (
            <div>
              <dt class="text-sm font-semibold uppercase tracking-wider text-text-muted-light dark:text-text-muted-dark">{t('projects.lastUpdated')}</dt>
              <dd class="mt-1 font-semibold text-text-main-light dark:text-text-main-dark">
                <time datetime={repoStats.pushedAt.toISOString()}>{formatMonthYear(repoStats.pushedAt, lang)}</time>
              </dd>
            </div>
          )}
        </dl>
      )}

      <ul class="flex flex-wrap gap-1.5" aria-label={t('projects.techUsedAria')}>
        {data.techStack.map((tech) => (
          <li><Badge variant="surface">{tech}</Badge></li>
        ))}
      </ul>
      <div class="max-w-md">
        <ProjectCardActions gitHubUrl={data.gitHubUrl} liveUrl={data.liveUrl} title={data.title} />
      </div>
    </header>

    <!-- Hero image (only when there is no screenshot gallery) -->
    {data.thumbnail && data.screenshots.length === 0 && (
      <a
        href={data.thumbnail.src}
        class={`mt-10 aspect-video ${zoomLink} rounded-2xl`}
        aria-label={`${t('projects.openFullSize')}: ${t('projects.screenshotAlt')} ${data.title}`}
        data-lightbox="hero"
        data-track-event={`project_image_zoom_${slug}`}
      >
        <Image
          src={data.thumbnail}
          alt={`${t('projects.screenshotAlt')} ${data.title}`}
          widths={[768, 1200, 1536]}
          sizes="(min-width: 768px) 720px, 100vw"
          loading="eager"
          fetchpriority="high"
          class={`h-full w-full object-cover ${zoomImage}`}
        />
      </a>
    )}

    <!-- Key highlights -->
    {data.highlights.length > 0 && (
      <section class="mt-12" aria-labelledby="highlights-heading">
        <h2 id="highlights-heading" class={sectionHeading}>{t('projects.highlights')}</h2>
        <ul class="mt-5 grid gap-3">
          {data.highlights.map((highlight) => (
            <li class="flex gap-3 rounded-xl bg-surface-light/60 p-4 text-text-main-light dark:bg-surface-dark/60 dark:text-text-main-dark">
              <Icon name="check" class="mt-0.5 h-5 w-5 text-accent-primary" />
              <span>{highlight}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Screenshots -->
    {data.screenshots.length > 0 && (
      <section class="mt-12" aria-labelledby="screenshots-heading">
        <h2 id="screenshots-heading" class={sectionHeading}>{t('projects.screenshots')}</h2>
        <div class:list={['mt-5 grid gap-4', data.screenshots.length > 1 && 'sm:grid-cols-2']}>
          {data.screenshots.map((shot, index) => (
            <figure class="flex flex-col gap-2">
              <a
                href={shot.src.src}
                class={`${zoomLink} rounded-xl shadow-sm`}
                aria-label={`${t('projects.openFullSize')}: ${shot.alt}`}
                data-lightbox="screenshots"
                data-caption={shot.caption}
                data-track-event={`project_screenshot_click_${slug}`}
              >
                <Image
                  src={shot.src}
                  alt={shot.alt}
                  widths={[400, 720, 1080, 1440]}
                  sizes={data.screenshots.length > 1 ? '(min-width: 768px) 352px, 100vw' : '(min-width: 768px) 720px, 100vw'}
                  loading={index < 2 ? 'eager' : 'lazy'}
                  class={`h-auto w-full ${zoomImage}`}
                />
              </a>
              {shot.caption && (
                <figcaption class="text-sm text-text-muted-light dark:text-text-muted-dark">{shot.caption}</figcaption>
              )}
            </figure>
          ))}
        </div>
      </section>
    )}

    <!-- Case study body (Markdown) -->
    <div class="prose prose-lg mt-12 max-w-none prose-code:before:content-none prose-code:after:content-none">
      <Content />
    </div>

    <!-- Collaborators -->
    {data.team.length > 0 && (
      <section class="mt-12" aria-labelledby="team-heading">
        <h2 id="team-heading" class={sectionHeading}>{t('projects.team')}</h2>
        <ul class="mt-4 flex flex-wrap gap-3">
          {data.team.map((member) => (
            <li>
              {member.url ? (
                <Link href={member.url} isExternal>{member.name}</Link>
              ) : (
                <span class="text-text-main-light dark:text-text-main-dark">{member.name}</span>
              )}
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Hiring call to action -->
    <aside class="mt-16 rounded-2xl bg-surface-light p-6 shadow-sm sm:p-8 dark:bg-surface-dark" aria-labelledby="cta-heading">
      <h2 id="cta-heading" class={sectionHeading}>{t('projects.cta.title')}</h2>
      <p class="mt-3 text-text-muted-light dark:text-text-muted-dark">{t('projects.cta.body')}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <Link
          href={SOCIAL_LINKS.linkedin.href}
          isExternal
          variant="button-primary"
          data-track-event={`project_cta_linkedin_${slug}`}
        >
          <Icon name="linkedin" class="h-5 w-5" />
          <span>{t(SOCIAL_LINKS.linkedin.labelKey)}</span>
        </Link>
        <Link
          href={SOCIAL_LINKS.github.href}
          isExternal
          variant="button-outline"
          data-track-event={`project_cta_github_${slug}`}
        >
          <Icon name="github" class="h-5 w-5" />
          <span>{t(SOCIAL_LINKS.github.labelKey)}</span>
        </Link>
      </div>
    </aside>

    <Link href={translatePath('/projects')} class="mt-10 inline-flex items-center gap-2" data-track-event="project_back_to_projects">
      <Icon name="arrow-left" class="h-4 w-4" />
      <span>{t('projects.back')}</span>
    </Link>
  </article>

  <ImageLightbox />
</Layout>
