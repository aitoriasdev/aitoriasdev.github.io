---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  isExternal?: boolean;
  variant?: 'default' | 'subtle' | 'button-primary' | 'button-secondary';
  class?: string;
}

const {
  href,
  isExternal = false,
  variant = 'default',
  class: className = '',
  ...rest
} = Astro.props;

const isOutbound = isExternal || href.startsWith('http');

const variants = {
  default:
    'font-medium text-text-main-light hover:text-accent-primary dark:text-text-main-dark dark:hover:text-accent-primary',
  subtle:
    'text-text-muted-light hover:text-text-main-light dark:text-text-muted-dark dark:hover:text-text-main-dark',
  'button-primary':
    'inline-flex items-center justify-center gap-2 rounded-xl bg-accent-primary px-5 py-3 text-md font-semibold text-bg-light shadow-sm hover:opacity-90 dark:text-bg-dark',
  'button-secondary':
    'inline-flex items-center justify-center gap-2 rounded-xl bg-surface-light px-5 py-3 text-md font-semibold text-text-main-light shadow-sm hover:bg-bg-light dark:bg-surface-dark dark:text-text-main-dark dark:hover:bg-bg-dark',
};
---

<a
  href={href}
  target={isOutbound ? '_blank' : undefined}
  rel={isOutbound ? 'noopener noreferrer' : undefined}
  class:list={[
    'transition-colors focus-visible:outline-2 focus-visible:outline-accent-primary',
    variants[variant],
    className,
  ]}
  {...rest}
>
  <slot />
  {
    isOutbound && (
      <span class="sr-only"> (opens in a new tab)</span>
    )
  }
</a>
