---
import Icon from '../components/shared/Icon.astro';
import Link from '../components/shared/Link.astro';
import Layout from '../layouts/Layout.astro';

// GitHub Pages serves this single 404.html for every unknown URL in both
// languages, so the page is bilingual instead of being built per locale.
const copy = [
  {
    lang: 'en',
    title: 'Page not found',
    body: "The page you're looking for doesn't exist or has moved.",
    home: 'Go to the home page',
    homeHref: '/',
    projects: 'See my projects',
    projectsHref: '/projects',
  },
  {
    lang: 'es',
    title: 'Página no encontrada',
    body: 'La página que buscas no existe o se ha movido.',
    home: 'Ir a la página de inicio',
    homeHref: '/es',
    projects: 'Ver mis proyectos',
    projectsHref: '/es/proyectos',
  },
];
---

<Layout title="404 | Aitorias" description={`${copy[0].title} · ${copy[1].title}`} alternates={false}>
  <meta name="robots" content="noindex" slot="head" />
  <section class="mx-auto flex max-w-3xl flex-col gap-12 px-6 py-20">
    <p class="text-7xl font-extrabold tracking-tight text-accent-primary dark:text-accent-primary-dark" aria-hidden="true">404</p>
    <div id="not-found-copy" class="flex flex-col gap-12">
      {copy.map((c, index) => (
        <div lang={c.lang} data-lang={c.lang} class="flex flex-col gap-4">
          {index === 0 ? (
            <h1 class="text-3xl font-bold text-text-main-light dark:text-text-main-dark">{c.title}</h1>
          ) : (
            <h2 class="text-3xl font-bold text-text-main-light dark:text-text-main-dark">{c.title}</h2>
          )}
          <p class="text-lg text-text-muted-light dark:text-text-muted-dark">{c.body}</p>
          <div class="flex flex-wrap gap-3">
            <Link href={c.homeHref} variant="button-primary" data-track-event={`not_found_home_${c.lang}`}>
              <Icon name="arrow-left" class="h-4 w-4" />
              <span>{c.home}</span>
            </Link>
            <Link href={c.projectsHref} variant="button-secondary" data-track-event={`not_found_projects_${c.lang}`}>
              <span>{c.projects}</span>
            </Link>
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>

<script>
  // Show the Spanish copy first when the missing URL was under /es/
  if (window.location.pathname.startsWith('/es/')) {
    const container = document.getElementById('not-found-copy');
    const spanish = container?.querySelector('[data-lang="es"]');

    if (container && spanish) {
      container.prepend(spanish);
      document.documentElement.lang = 'es';
    }
  }
</script>
