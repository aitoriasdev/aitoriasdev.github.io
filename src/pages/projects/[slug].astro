---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { useTranslations } from '../../i18n/utils';
import type { InferGetStaticPropsType } from 'astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', (p) => p.data.lang === 'en');

  return projects.map((project) => ({
    params: { slug: project.id.split('/').pop() },
    props: { project },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { project } = Astro.props;
const { Content } = await render(project);
const t = useTranslations('en');
---

<Layout title={`${project.data.title} | Aitorias.dev`} description={project.data.tagline}>
  <div class="mx-auto max-w-3xl px-6 py-12">
    <a href="/projects" class="inline-block text-md font-medium text-accent-primary hover:underline mb-6">
      ← <span>{t('projects.viewAll')}</span>
    </a>

    {project.data.thumbnail && (
      <div class="mb-6 aspect-video overflow-hidden rounded-2xl bg-surface-light dark:bg-surface-dark">
        <Image src={project.data.thumbnail} alt={project.data.title} class="h-full w-full object-cover" />
      </div>
    )}

    <article class="prose dark:prose-invert max-w-none">
      <Content />
    </article>
  </div>
</Layout>
