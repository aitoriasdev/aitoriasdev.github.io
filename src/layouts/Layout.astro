---
import type { ImageMetadata } from "astro";
import { Font, getImage } from "astro:assets";
import { PUBLIC_GA_MEASUREMENT_ID as gaId } from "astro:env/client";
import AccessibilityMenu from '../components/shared/AccessibilityMenu.astro';
import CookieBanner from '../components/shared/CookieBanner.astro';
import Footer from '../components/shared/footer/Footer.astro';
import GoogleAnalytics from '../components/shared/analytics/GoogleAnalytics.astro';
import GoogleAnalyticsTracker from '../components/shared/analytics/GoogleAnalyticsTracker.astro';
import Header from '../components/shared/header/Header.astro';
import MenuDrawer from '../components/shared/drawer/MenuDrawer.astro';
import defaultOgImage from "../assets/images/og-default.png";
import { languages, type Lang } from "../i18n/ui";
import { getLangFromUrl, getRouteFromUrl, useTranslatedPath, useTranslations } from "../i18n/utils";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  author?: string;
  /** Social preview image (defaults to the generic site card). */
  image?: ImageMetadata;
  imageAlt?: string;
  type?: "website" | "article";
  /** Structured data rendered as JSON-LD. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Set to false for pages that only exist once (e.g. 404). */
  alternates?: boolean;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  title = `Aitorias - ${t('title')}`,
  description = t('description'),
  author = 'Aitor',
  image = defaultOgImage,
  imageAlt = title,
  type = 'website',
  jsonLd,
  alternates = true,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const withTrailingSlash = (path: string) => (path.endsWith('/') ? path : `${path}/`);

// Same page in every language (routes are translated, e.g. /projects <-> /es/proyectos)
const route = getRouteFromUrl(Astro.url);
const alternateLinks = alternates
  ? (Object.keys(languages) as Lang[]).map((alternateLang) => ({
      lang: alternateLang,
      href: new URL(withTrailingSlash(useTranslatedPath(alternateLang)(route)), Astro.site).href,
    }))
  : [];
const defaultAlternate = alternateLinks.find((link) => link.lang === 'en');

const ogLocales: Record<Lang, string> = { en: 'en_US', es: 'es_ES' };
const ogImage = await getImage({ src: image, format: 'png', width: 1200 });
const ogImageURL = new URL(ogImage.src, Astro.site).href;

// Escape "<" so content can never close the <script> element early
const jsonLdHtml = jsonLd && JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content={author} />

		<!-- Open Graph / Social Media Meta Tags -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:site_name" content="aitorias.is-a.dev" />
		<meta property="og:locale" content={ogLocales[lang]} />
		{(Object.keys(ogLocales) as Lang[]).filter((l) => l !== lang).map((l) => (
			<meta property="og:locale:alternate" content={ogLocales[l]} />
		))}
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content={String(ogImage.attributes.width ?? ogImage.options.width)} />
		<meta property="og:image:height" content={String(ogImage.attributes.height ?? ogImage.options.height ?? '')} />
		<meta property="og:image:alt" content={imageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<!-- Canonical URL Tag -->
		<link rel="canonical" href={canonicalURL} />
		{alternateLinks.map((link) => <link rel="alternate" hreflang={link.lang} href={link.href} />)}
		{defaultAlternate && <link rel="alternate" hreflang="x-default" href={defaultAlternate.href} />}
		{jsonLdHtml && <script type="application/ld+json" set:html={jsonLdHtml} />}
		<slot name="head" />

    <Font cssVariable="--font-open-dyslexic" />
		<!-- Apply persisted theme + accessibility preferences before first paint (avoids a flash) -->
		<script is:inline>
			(function () {
				const root = document.documentElement;
				const theme = localStorage.getItem('theme') || 'system';
				const isDark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);

				root.classList.toggle('dark', isDark);

				// Keep in sync with the toggles in AccessibilityMenu.astro
				const a11yPrefs = {
					'a11y-reduce-motion': 'reduce-motion',
					'a11y-high-contrast': 'high-contrast',
					'a11y-large-text': 'large-text',
					'a11y-dyslexic-font': 'dyslexic-font',
				};

				Object.entries(a11yPrefs).forEach(([key, className]) => {
					root.classList.toggle(className, localStorage.getItem(key) === 'true');
				});
			})();
		</script>
    {gaId && <GoogleAnalytics measurementId={gaId} />}
    {gaId && <GoogleAnalyticsTracker />}
	</head>
	<body class="bg-bg-light text-text-main-light transition-colors dark:bg-bg-dark dark:text-text-main-dark">
		<a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-accent-primary focus:px-4 focus:py-2 focus:text-bg-light focus:outline-2 focus:outline-offset-2 focus:outline-accent-primary dark:focus:text-bg-dark"
    >
      {t('nav.skipToContent')}
    </a>
    <Header />
		<main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <MenuDrawer />
    <CookieBanner />
    <AccessibilityMenu />
	</body>
</html>
